{
  /**
   * Description:
   * Enables schema-aware validation for the declaration-only typecheck producer.
   *
   * Architectural decision:
   * This graph producer is an independently maintained configuration surface.
   *
   * Example:
   * "$schema": "https://json.schemastore.org/tsconfig"
   */
  "$schema": "https://json.schemastore.org/tsconfig",

  /**
   * Description:
   * Reuses direct Node runtime semantics without inheriting its delivery owner.
   *
   * Architectural decision:
   * The producer needs the same host and module truth, while its declaration
   * output remains isolated from application runtime output.
   *
   * Example:
   * "extends": "./tsconfig.node.json"
   */
  "extends": "./tsconfig.node.json",

  /**
   * Description:
   * Groups graph-producer and internal validation-artifact deltas.
   *
   * Architectural decision:
   * This is the only composite producer in the single-project graph.
   *
   * Example:
   * "compilerOptions": { "composite": true }
   */
  "compilerOptions": {
    /**
     * Description:
     * Enables project-reference build-mode participation.
     *
     * Architectural decision:
     * Consumer configs must reference a real composite declaration producer.
     *
     * Example:
     * "composite": true
     */
    "composite": true,

    /**
     * Description:
     * Reopens output required by the reference graph.
     *
     * Architectural decision:
     * A no-emit config cannot fulfill producer responsibilities.
     *
     * Example:
     * "noEmit": false
     */
    "noEmit": false,

    /**
     * Description:
     * Restricts graph output to declarations.
     *
     * Architectural decision:
     * Runtime JavaScript remains exclusively owned by tsconfig.node.json.
     *
     * Example:
     * "emitDeclarationOnly": true
     */
    "emitDeclarationOnly": true,

    /**
     * Description:
     * Enables declaration files for referenced consumers.
     *
     * Architectural decision:
     * The graph must expose a real type producer.
     *
     * Example:
     * "declaration": true
     */
    "declaration": true,

    /**
     * Description:
     * Enables declaration maps for cross-project type navigation.
     *
     * Architectural decision:
     * Internal graph artifacts preserve traceability without becoming runtime
     * artifacts.
     *
     * Example:
     * "declarationMap": true
     */
    "declarationMap": true,

    /**
     * Description:
     * Requires independently declaration-generatable exports.
     *
     * Architectural decision:
     * Exported contracts cannot rely on hidden whole-program inference.
     *
     * Example:
     * "isolatedDeclarations": true
     */
    "isolatedDeclarations": true,

    /**
     * Description:
     * Disables JavaScript source-map output.
     *
     * Architectural decision:
     * This lane emits declarations only and therefore owns no JavaScript maps.
     *
     * Example:
     * "sourceMap": false
     */
    "sourceMap": false,

    /**
     * Description:
     * Places validation declarations outside runtime distribution output.
     *
     * Architectural decision:
     * Internal build artifacts must not be exposed as deployable application
     * files.
     *
     * Example:
     * "outDir": "./.tsbuild/typecheck"
     */
    "outDir": "./.tsbuild/typecheck",

    /**
     * Description:
     * Places incremental typecheck build state under the internal build area.
     *
     * Architectural decision:
     * Build state remains separate from runtime and package delivery artifacts.
     *
     * Example:
     * "tsBuildInfoFile": "./.tsbuild/tsconfig.typecheck.tsbuildinfo"
     */
    "tsBuildInfoFile": "./.tsbuild/tsconfig.typecheck.tsbuildinfo"
  },

  /**
   * Description:
   * Includes only implementation source in the graph-validation producer.
   *
   * Architectural decision:
   * Consumer test source retains separate ownership and cannot enter the
   * producer program by accident.
   *
   * Example:
   * "include": ["src/**\/*.ts"]
   */
  "include": ["src/**/*.ts"]
}
