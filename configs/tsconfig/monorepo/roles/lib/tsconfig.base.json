{
  /**
   * Description:
   * Enables schema-aware validation for the abstract library role template.
   *
   * Architectural decision:
   * Every independently maintained TSConfig surface declares the official
   * schema so structural drift is caught at the editing boundary.
   *
   * Example:
   * "$schema": "https://json.schemastore.org/tsconfig"
   */
  "$schema": "https://json.schemastore.org/tsconfig",

  /**
   * Description:
   * Inherits the universal root compiler-policy materialization.
   *
   * Architectural decision:
   * The role adds library capability only; it must not fork any canonical core
   * strictness, module, resolver, or ambient policy.
   *
   * Example:
   * "extends": "./tsconfig.base.json"
   */
  "extends": "./tsconfig.base.json",

  /**
   * Description:
   * Groups the compiler options exclusively owned by the abstract library role.
   *
   * Architectural decision:
   * Role-wide declaration and graph capability is centralized here while
   * terminal delivery remains in narrower child roles.
   *
   * Example:
   * "compilerOptions": { "composite": true }
   */
  "compilerOptions": {
    /**
     * Description:
     * Enables participation in the TypeScript project-reference graph.
     *
     * Architectural decision:
     * Buildable library capability must be structurally explicit before a
     * declaration or runtime artifact role can become a producer.
     *
     * Example:
     * "composite": true
     */
    "composite": true,

    /**
     * Description:
     * Enables declaration-file emission capability for terminal library roles.
     *
     * Architectural decision:
     * Public package contracts are declaration-capable by design, even though
     * this abstract role does not itself select a terminal emit contract.
     *
     * Example:
     * "declaration": true
     */
    "declaration": true,

    /**
     * Description:
     * Enables declaration maps for public type navigation.
     *
     * Architectural decision:
     * Cross-project navigation remains traceable without letting terminal
     * delivery behavior leak into leaves.
     *
     * Example:
     * "declarationMap": true
     */
    "declarationMap": true,

    /**
     * Description:
     * Requires exported declarations to carry sufficient explicit annotations
     * for isolated declaration generation.
     *
     * Architectural decision:
     * Public API contracts must not rely on hidden whole-program inference.
     *
     * Example:
     * "isolatedDeclarations": true
     */
    "isolatedDeclarations": true,

    /**
     * Description:
     * Keeps the abstract library capability non-emitting.
     *
     * Architectural decision:
     * Only a terminal artifact or source-first role may own the delivery
     * contract; this shared parent must remain neutral.
     *
     * Example:
     * "noEmit": true
     */
    "noEmit": true,

    /**
     * Description:
     * Excludes @internal declarations from the public declaration surface.
     *
     * Architectural decision:
     * Internal implementation details must not become an accidental package API.
     *
     * Example:
     * "stripInternal": true
     */
    "stripInternal": true
  }
}
