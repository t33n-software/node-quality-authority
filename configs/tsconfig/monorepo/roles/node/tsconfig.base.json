{
  /**
   * Description:
   * Enables schema-aware validation for the direct Node application role.
   *
   * Architectural decision:
   * Direct Node emission is a distinct terminal delivery boundary and must be
   * explicit rather than inferred from a generic root.
   *
   * Example:
   * "$schema": "https://json.schemastore.org/tsconfig"
   */
  "$schema": "https://json.schemastore.org/tsconfig",

  /**
   * Description:
   * Inherits the canonical universal root policy.
   *
   * Architectural decision:
   * This role overrides only direct-Node runtime facts and does not fork core
   * strictness or package policy.
   *
   * Example:
   * "extends": "./tsconfig.base.json"
   */
  "extends": "./tsconfig.base.json",

  /**
   * Description:
   * Groups direct Node runtime and artifact-owner deltas.
   *
   * Architectural decision:
   * This role becomes the sole TypeScript-owned JavaScript producer for a
   * deployable Node app.
   *
   * Example:
   * "compilerOptions": { "module": "Node20" }
   */
  "compilerOptions": {
    /**
     * Description:
     * Selects the highest currently available fixed Node module-semantics mode.
     *
     * Architectural decision:
     * Node20 is stable across compiler upgrades; NodeNext remains a registered
     * exception only when fixed semantics cannot model the approved runtime.
     *
     * Example:
     * "module": "Node20"
     */
    "module": "Node20",

    /**
     * Description:
     * Selects the resolver family required by the fixed Node20 module mode.
     *
     * Architectural decision:
     * This explicit override prevents the generic inherited Bundler resolver
     * from creating an invalid Node20/Bundler effective configuration.
     *
     * Example:
     * "moduleResolution": "Node16"
     */
    "moduleResolution": "Node16",

    /**
     * Description:
     * Reopens TypeScript output for executable Node JavaScript.
     *
     * Architectural decision:
     * A deployable Node application requires exactly one explicit runtime
     * producer.
     *
     * Example:
     * "noEmit": false
     */
    "noEmit": false,

    /**
     * Description:
     * Confirms that this role does not produce declarations only.
     *
     * Architectural decision:
     * Application runtime output is JavaScript; declaration-only output belongs
     * to a dedicated validation or package role.
     *
     * Example:
     * "emitDeclarationOnly": false
     */
    "emitDeclarationOnly": false,

    /**
     * Description:
     * Disables application declaration output.
     *
     * Architectural decision:
     * The app delivery role does not become a package-type producer.
     *
     * Example:
     * "declaration": false
     */
    "declaration": false,

    /**
     * Description:
     * Disables declaration maps for the application delivery role.
     *
     * Architectural decision:
     * No declaration artifact is owned by this runtime lane.
     *
     * Example:
     * "declarationMap": false
     */
    "declarationMap": false,

    /**
     * Description:
     * Enables JavaScript source maps for runtime diagnostics.
     *
     * Architectural decision:
     * The TypeScript runtime producer owns debugging mappings for its emitted
     * JavaScript.
     *
     * Example:
     * "sourceMap": true
     */
    "sourceMap": true,

    /**
     * Description:
     * Keeps raw TypeScript extension imports closed for emitted JavaScript.
     *
     * Architectural decision:
     * Runtime specifiers must name the JavaScript artifact truth, not raw
     * TypeScript source files.
     *
     * Example:
     * "allowImportingTsExtensions": false
     */
    "allowImportingTsExtensions": false,

    /**
     * Description:
     * Disables relative TypeScript-extension rewriting.
     *
     * Architectural decision:
     * Direct Node artifacts author runtime-valid specifiers rather than relying
     * on a source-first rewrite capability.
     *
     * Example:
     * "rewriteRelativeImportExtensions": false
     */
    "rewriteRelativeImportExtensions": false,

    /**
     * Description:
     * Reopens Node ambient declarations for the direct Node host.
     *
     * Architectural decision:
     * Host globals remain opt-in and must not leak into browser or generic lanes.
     *
     * Example:
     * "types": ["node"]
     */
    "types": ["node"]
  }
}
