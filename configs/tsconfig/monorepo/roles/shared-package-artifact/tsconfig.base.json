{
  /**
   * Description:
   * Enables schema-aware validation for the runtime-bearing package artifact
   * role.
   *
   * Architectural decision:
   * An unbundled shared package needs its own terminal TSConfig surface so
   * package metadata always matches real compiler output.
   *
   * Example:
   * "$schema": "https://json.schemastore.org/tsconfig"
   */
  "$schema": "https://json.schemastore.org/tsconfig",

  /**
   * Description:
   * Inherits abstract library graph and declaration capability.
   *
   * Architectural decision:
   * This terminal role adds package-artifact truth only and does not fork the
   * universal or library-core policy.
   *
   * Example:
   * "extends": "./tsconfig.lib.base.json"
   */
  "extends": "./tsconfig.lib.base.json",

  /**
   * Description:
   * Groups Node-valid runtime-package artifact output deltas.
   *
   * Architectural decision:
   * The role centrally owns every compiler setting required to emit JavaScript
   * plus declarations for an unbundled package.
   *
   * Example:
   * "compilerOptions": { "module": "Node20" }
   */
  "compilerOptions": {
    /**
     * Description:
     * Selects the fixed Node module-semantics mode for the emitted package.
     *
     * Architectural decision:
     * Node20 is the current fixed compiler mode; a moving NodeNext mode needs a
     * registered exception.
     *
     * Example:
     * "module": "Node20"
     */
    "module": "Node20",

    /**
     * Description:
     * Selects the resolver family required by the fixed Node20 module mode.
     *
     * Architectural decision:
     * The explicit Node16 override prevents the generic Bundler resolver from
     * surviving inheritance into a direct artifact runtime lane.
     *
     * Example:
     * "moduleResolution": "Node16"
     */
    "moduleResolution": "Node16",

    /**
     * Description:
     * Reopens compiler output for the runtime package artifact.
     *
     * Architectural decision:
     * Package metadata may promise JavaScript only when this terminal producer
     * actually emits it.
     *
     * Example:
     * "noEmit": false
     */
    "noEmit": false,

    /**
     * Description:
     * Confirms JavaScript-plus-declaration production instead of declaration-only
     * output.
     *
     * Architectural decision:
     * Runtime-bearing schemas, validators, constants, and functions require a
     * real JavaScript artifact.
     *
     * Example:
     * "emitDeclarationOnly": false
     */
    "emitDeclarationOnly": false,

    /**
     * Description:
     * Emits source maps for diagnostics against the package JavaScript artifact.
     *
     * Architectural decision:
     * The package producer owns debugging mappings for its own runtime output.
     *
     * Example:
     * "sourceMap": true
     */
    "sourceMap": true,

    /**
     * Description:
     * Keeps raw TypeScript extension imports closed in the package artifact.
     *
     * Architectural decision:
     * Published JavaScript packages must not expose a TypeScript-source import
     * contract to consumers.
     *
     * Example:
     * "allowImportingTsExtensions": false
     */
    "allowImportingTsExtensions": false,

    /**
     * Description:
     * Disables relative TypeScript-extension rewriting.
     *
     * Architectural decision:
     * Artifact-owned source authors direct .js runtime specifiers rather than
     * relying on a source-first rewriting capability.
     *
     * Example:
     * "rewriteRelativeImportExtensions": false
     */
    "rewriteRelativeImportExtensions": false
  }
}
