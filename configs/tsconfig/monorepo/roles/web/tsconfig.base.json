{
  /**
   * Description:
   * Enables schema-aware validation for the bundler-first web role.
   *
   * Architectural decision:
   * Web-host facts remain a dedicated role surface rather than widening the
   * universal root contract.
   *
   * Example:
   * "$schema": "https://json.schemastore.org/tsconfig"
   */
  "$schema": "https://json.schemastore.org/tsconfig",

  /**
   * Description:
   * Inherits the canonical universal root policy.
   *
   * Architectural decision:
   * The web role adds only browser host and bundler-delivery facts.
   *
   * Example:
   * "extends": "./tsconfig.base.json"
   */
  "extends": "./tsconfig.base.json",

  /**
   * Description:
   * Groups browser-library and bundler-output ownership deltas.
   *
   * Architectural decision:
   * The bundler remains the only runtime artifact producer.
   *
   * Example:
   * "compilerOptions": { "noEmit": true }
   */
  "compilerOptions": {
    /**
     * Description:
     * Reopens browser APIs for web leaves.
     *
     * Architectural decision:
     * DOM ambient declarations belong only to browser-hosted roles, never to
     * the universal root or Node lanes.
     *
     * Example:
     * "lib": ["DOM", "DOM.Iterable", "ES2025"]
     */
    "lib": ["DOM", "DOM.Iterable", "ES2025"],

    /**
     * Description:
     * Prevents TypeScript from emitting web runtime artifacts.
     *
     * Architectural decision:
     * The bundler owns JavaScript, assets, source maps, and packaging.
     *
     * Example:
     * "noEmit": true
     */
    "noEmit": true
  }
}
