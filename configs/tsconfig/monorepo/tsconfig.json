{
  /**
   * Description:
   * Enables schema-aware validation for the monorepo solution root.
   *
   * Architectural decision:
   * The solution root is a first-class orchestration surface and must remain
   * structurally explicit.
   *
   * Example:
   * "$schema": "https://json.schemastore.org/tsconfig"
   */
  "$schema": "https://json.schemastore.org/tsconfig",

  /**
   * Description:
   * Connects the solution root to the generated root-base materialization.
   *
   * Architectural decision:
   * The full policy is owned by the canonical universal source; the solution
   * root merely consumes the repository's materialized tsconfig.base.json.
   *
   * Example:
   * "extends": "./tsconfig.base.json"
   */
  "extends": "./tsconfig.base.json",

  /**
   * Description:
   * Declares that the solution root owns no source files directly.
   *
   * Architectural decision:
   * It coordinates projects only and cannot create a second implicit program.
   *
   * Example:
   * "files": []
   */
  "files": [],

  /**
   * Description:
   * Stops project-reference traversal after an upstream build error.
   *
   * Architectural decision:
   * Downstream artifacts must not be produced or normalized after an upstream
   * producer becomes invalid.
   *
   * Example:
   * "stopBuildOnErrors": true
   */
  "stopBuildOnErrors": true,

  /**
   * Description:
   * Registers top-level project producers in the solution graph.
   *
   * Architectural decision:
   * Project references are explicit graph edges; framework tooling may
   * synchronize them but cannot replace their ownership semantics.
   *
   * Example:
   * "references": [{ "path": "./packages/billing/billing-contracts/tsconfig.lib.json" }]
   */
  "references": [
    {
      "path": "./packages/billing/billing-contracts/tsconfig.lib.json"
    },
    {
      "path": "./apps/billing/api/tsconfig.node.json"
    },
    {
      "path": "./apps/billing/web/tsconfig.web.json"
    }
  ]
}
