{
  /**
   * Enables editor validation and completion for the TSConfig file itself.
   *
   * Detailed behavior:
   * - Gives JSONC-aware tooling the official TSConfig schema.
   * - Prevents silent drift in configuration structure.
   *
   * Architectural decision:
   * Keep the SchemaStore reference because this file is part of the repository's
   * explicit configuration surface and should remain self-validating.
   *
   * Example:
   * "$schema": "https://json.schemastore.org/tsconfig"
   */
  "$schema": "https://json.schemastore.org/tsconfig",

  /**
   * Inherits the shared strict baseline and opens only the producer-specific deltas.
   *
   * Detailed behavior:
   * - Reuses universal strictness, fixed edition, and package-resolution policy.
   * - Avoids duplicated policy between base and producer files.
   *
   * Architectural decision:
   * Keep `extends` because the producer should specialize the baseline, not fork it.
   *
   * Example:
   * "extends": "./tsconfig.base.json"
   */
  "extends": "./tsconfig.base.json",

  /**
   * Description:
   * Groups direct Node runtime and producer-specific deltas.
   *
   * Architectural decision:
   * The generated canonical base owns all core policy; this producer owns only
   * Node host, output, and local file-system facts.
   *
   * Example:
   * "compilerOptions": { "module": "Node20" }
   */
  "compilerOptions": {
    /**
     * Description:
     * Models native Node output through the highest available fixed module mode.
     *
     * Architectural decision:
     * Node20 remains stable across compiler upgrades; NodeNext requires a
     * registered exception based on semantics unavailable in a fixed mode.
     *
     * Example:
     * "module": "Node20"
     */
    "module": "Node20",

    /**
     * Description:
     * Selects the resolver family paired with the fixed Node20 module mode.
     *
     * Architectural decision:
     * The explicit Node16 override prevents an inherited Bundler resolver from
     * producing an invalid effective configuration.
     *
     * Example:
     * "moduleResolution": "Node16"
     */
    "moduleResolution": "Node16",

    /**
     * Description:
     * Reopens Node ambient declarations for this host-Node producer.
     *
     * Architectural decision:
     * Node globals remain explicit lane-local facts and do not leak through the
     * canonical base.
     *
     * Example:
     * "types": ["node"]
     */
    "types": ["node"],

    /**
     * Description:
     * Reopens compiler output for executable Node JavaScript.
     *
     * Architectural decision:
     * The direct Node lane is the sole TypeScript runtime producer for this
     * application.
     *
     * Example:
     * "noEmit": false
     */
    "noEmit": false,

    /**
     * Description:
     * Confirms that output is not declaration-only.
     *
     * Architectural decision:
     * Runtime JavaScript belongs here, while declaration-only graph output has
     * a dedicated typecheck producer.
     *
     * Example:
     * "emitDeclarationOnly": false
     */
    "emitDeclarationOnly": false,

    /**
     * Description:
     * Disables application declaration output.
     *
     * Architectural decision:
     * The direct runtime app is not a public package-type artifact producer.
     *
     * Example:
     * "declaration": false
     */
    "declaration": false,

    /**
     * Description:
     * Disables declaration maps for the direct runtime app.
     *
     * Architectural decision:
     * No application declaration artifact is owned in this lane.
     *
     * Example:
     * "declarationMap": false
     */
    "declarationMap": false,

    /**
     * Description:
     * Enables source maps for emitted Node JavaScript.
     *
     * Architectural decision:
     * The runtime producer owns diagnostics mapping for its own artifact.
     *
     * Example:
     * "sourceMap": true
     */
    "sourceMap": true,

    /**
     * Description:
     * Declares the application source root.
     *
     * Architectural decision:
     * Source placement is a local project fact, not universal policy.
     *
     * Example:
     * "rootDir": "./src"
     */
    "rootDir": "./src",

    /**
     * Description:
     * Declares the application runtime artifact directory.
     *
     * Architectural decision:
     * Output placement remains owned by the concrete deployable application.
     *
     * Example:
     * "outDir": "./dist"
     */
    "outDir": "./dist"
  },

  /**
   * Defines the complete producer-owned source surface.
   *
   * Detailed behavior:
   * - Includes only the direct runtime source tree owned by this producer.
   * - Keeps scripts, tooling, tests, and configuration files in separate lanes.
   *
   * Architectural decision:
   * Keep this include list code-centric and explicit so the producer graph reflects executable and type-checked source truth only.
   *
   * Example:
   * "include": ["src/**\/*.ts"]
   */
  "include": ["src/**/*.ts"]
}
